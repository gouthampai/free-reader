{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free Reader",
  "version": "0.1.0",
  "identifier": "com.freereader.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Free Reader",
        "width": 1200,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/**"
        ]
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: ws://localhost:1420 ws://localhost:1421",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Reference",
    "shortDescription": "A polished ereader",
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": [
          "mobi",
          "azw",
          "azw3"
        ],
        "name": "Mobipocket eBook",
        "mimeType": "application/x-mobipocket-ebook",
        "role": "Viewer"
      },
      {
        "ext": [
          "fb2",
          "fbz"
        ],
        "name": "FictionBook",
        "mimeType": "application/x-fictionbook+xml",
        "role": "Viewer"
      },
      {
        "ext": [
          "cbz"
        ],
        "name": "Comic Book Archive",
        "mimeType": "application/vnd.comicbook+zip",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ]
  }
}
