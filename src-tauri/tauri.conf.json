{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free Reader",
  "version": "0.1.0",
  "identifier": "com.freereader.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Free Reader",
        "width": 1200,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Books",
    "shortDescription": "A polished ereader",
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      }
    ]
  }
}
